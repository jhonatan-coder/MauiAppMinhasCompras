<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Somar" Clicked="ToolbarItem_Clicked_1"/>
        <ToolbarItem Text="Adicionar" Clicked="ToolbarItem_Clicked" />
        
    </ContentPage.ToolbarItems>
    <VerticalStackLayout>
        
        <SearchBar x:Name="txt_search" Placeholder="Pesquisa de produtos" 
                   TextChanged="txt_search_TextChanged"/>
        
        <CollectionView x:Name="lst_produtos" >
            <!--Cabeçalho da lista-->
            <CollectionView.Header>
                <Grid ColumnDefinitions="*, *, *, *, *">
                    <Label Grid.Column="0" Text="ID" />
                    <Label Grid.Column="1" Text="Descrição" />
                    <Label Grid.Column="2" Text="Preço" />
                    <Label Grid.Column="3" Text="Quantidade" />
                    <Label Grid.Column="4" Text="Total" />
                </Grid>
            </CollectionView.Header>
            
                <!-- Itens da Lista com SwipeView-->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    
                    <!--Envolvendo tudo com SwipeView-->
                    <SwipeView HeightRequest="60" BackgroundColor="Gray">
                        <!---Definindo As Ações do Swipe-->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <!---Ação de excluir-->
                                <SwipeItem Text="Excluir" BackgroundColor="Red" Clicked="SwipeItem_Clicked"/>
                                <!---Ação de editar-->
                                <SwipeItem Text="Editar" BackgroundColor="Orange" Clicked="SwipeItem_Clicked_1"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <SwipeView.Content>
                            <Grid ColumnDefinitions="*, *, *, *, *" Padding="10">
                                <Label Grid.Column="0" Text="{Binding Id}" />
                                <Label Grid.Column="1" Text="{Binding Descricao}" />
                                <Label Grid.Column="2" Text="{Binding Preco}" />
                                <Label Grid.Column="3" Text="{Binding Quantidade}" />
                                <Label Grid.Column="4" Text="{Binding Total}" />
                            </Grid>
                        </SwipeView.Content>
                        
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>