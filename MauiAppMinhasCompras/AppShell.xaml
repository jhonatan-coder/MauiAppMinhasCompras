<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppMinhasCompras.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAppMinhasCompras.Views"
    Title="MauiAppMinhasCompras"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}"
    Shell.DisabledColor="Gray"
    Shell.UnselectedColor="{StaticResource Gray200}">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:ListaProduto}"
        Route="MainPage" />

</Shell>
